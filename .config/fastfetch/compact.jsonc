{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "source": "$HOME/.config/quickshell/imgs/pfp3.png",
    "width": 16,
    "height": 7,
    "padding": { "top": 0, "right": 2 }
  },
  "display": { "separator": " " },
  "modules": [
    { "type": "os",
      "format": "Arch Linux x86_64",     "key": " 󰌽 ", "keyColor": "38;5;240" },
    { "type": "kernel", "key": "  ", "keyColor": "38;5;240" },
    { "type": "wm",     "key": " 󰨇 ", "keyColor": "38;5;240" },
    { "type": "shell",  "key": " 󰞷 ", "keyColor": "38;5;240" },
    { "type": "cpu",    "key": "  ", "keyColor": "38;5;240" },
    { "type": "memory", "key": " 󰘚 ", "keyColor": "38;5;240" }
  ]
}
