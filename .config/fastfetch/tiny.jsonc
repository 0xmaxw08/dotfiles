{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "none" },
  "display": { "separator": " " },
  "modules": [
    { "type": "os",     "key": "", "format": "Arch Linux" },
    { "type": "wm",     "key": "", "format": "{pretty-name}" },
    { "type": "memory", "key": "", "format": "{used} / {total}" }
  ]
}
