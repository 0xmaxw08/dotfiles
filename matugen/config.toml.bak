[config]
reload_apps = true

[templates.waybar-floating]
input_path = '~/.config/matugen/templates/waybar-floating.css'
output_path = '~/.config/waybar/style-floating.css'

[templates.wofi]
input_path = '~/.config/matugen/templates/wofi-colors.css'
output_path = '~/.config/wofi/style.css'

[templates.kitty]
input_path = '~/.config/matugen/templates/kitty-colors.conf'
output_path = '~/.config/kitty/colors.conf'

[templates.mako]
input_path = '~/.config/matugen/templates/mako-colors'
output_path = '~/.config/mako/config'

[templates.hyprland]
input_path = '~/.config/matugen/templates/hyprland-colors.conf'
output_path = '~/.config/hypr/colors.conf'

post_hook = "~/.config/waybar/toggle.sh & sleep 0.5 && ~/.config/waybar/toggle.sh & makoctl reload & ~/.local/bin/apply-hypr-colors.sh &"
