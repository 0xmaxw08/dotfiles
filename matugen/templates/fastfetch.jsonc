// ~/.config/fastfetch/config.jsonc
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "kitty",
        "source": "~/.config/fastfetch/logo.png",
        "width": 30,
        "height": 15,
        "padding": { "top": 1, "right": 2 }
    },

    "display": {
        "separator": " ",
        "color": {
            "keys": "{{colors.primary_fixed.dark.hex}}",
            "title": "{{colors.on_surface.dark.hex}}"
        }
    },

    "modules": [
        "title",
        "separator",
        { "type": "os", "key": " OS", "format": "Arch Linux" },
        { "type": "packages", "key": "󰏖 Packages" },
        { "type": "shell", "key": " Shell" },
        { "type": "wm", "key": "󱂬 WM" },
        { "type": "terminal", "key": " Term" },
        { "type": "cpu", "key": " CPU" },
        { "type": "gpu", "key": "󰢮 GPU" },
        { "type": "memory", "key": "󰍛 Memory" },
        { "type": "disk", "key": "󰋊 Disk" },
        { "type": "uptime", "key": "󰅐 Uptime" },
        "break",
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        }
    ]
}
