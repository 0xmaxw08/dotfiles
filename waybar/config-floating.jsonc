{
    "layer": "top",
    "position": "top",
    "height": 28,
    "spacing": 2,
    "margin-top": 0,
    "margin-left": 5,
    "margin-right": 5,

    "modules-left": ["group/workspaces", "hyprland/window"],
    "modules-center": ["mpris", "clock"],
    "modules-right": ["custom/wallpaper", "custom/fan", "pulseaudio", "network", "cpu", "memory", "temperature", "battery", "group/tray-group"],

    "custom/fan": {
    "exec": "~/.config/waybar/fan-status.sh",
    "return-type": "json",
    "interval": 2,
    "on-click": "~/.config/hypr/fan-toggle.sh"
    },
    "group/workspaces": {
        "orientation": "horizontal",
        "modules": ["custom/ws1", "custom/ws2", "custom/ws3", "custom/ws4", "custom/ws5", "custom/ws-extra"]
    }, 
    "custom/ws1": {
        "exec": "~/.config/waybar/ws-status.sh 1",
        "return-type": "json",
        "interval": 5,
        "signal": 8,
        "signal": 8,
        "on-click": "hyprctl dispatch \"hl.dsp.focus({ workspace = 1 })\""
    },
    
    "custom/ws2": {
        "exec": "~/.config/waybar/ws-status.sh 2",
        "return-type": "json",
        "interval": 5,
        "signal": 8,
        "signal": 8,
        "on-click": "hyprctl dispatch \"hl.dsp.focus({ workspace = 2 })\""
    },
    
    "custom/ws3": {
        "exec": "~/.config/waybar/ws-status.sh 3",
        "return-type": "json",
        "interval": 5,
        "signal": 8,
        "signal": 8,
        "on-click": "hyprctl dispatch \"hl.dsp.focus({ workspace = 3 })\""
    },
    
    "custom/ws4": {
        "exec": "~/.config/waybar/ws-status.sh 4",
        "return-type": "json",
        "interval": 5,
        "signal": 8,
        "signal": 8,
        "on-click": "hyprctl dispatch \"hl.dsp.focus({ workspace = 4 })\""
    },

    "custom/ws5": {
        "exec": "~/.config/waybar/ws-status.sh 5",
        "return-type": "json",
        "interval": 5,
        "signal": 8,
        "signal": 8,
        "on-click": "hyprctl dispatch \"hl.dsp.focus({ workspace = 5 })\""
    },
    
    "custom/ws-extra": {
        "exec": "~/.config/waybar/ws-current.sh",
        "return-type": "json",
        "interval": 1,
        "signal": 8
    },
    
    "hyprland/window": {
        "format": "{}",
        "separate-outputs": true
    },

    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%a, %d %b %Y}",
        "tooltip-format": "<big><b>{:%A, %d %B %Y}</b></big>\n\n<tt>{calendar}</tt>"
    },

    "mpris": {
        "format": "{player_icon} {title} — {artist}",
        "format-paused": "{player_icon} {title} — {artist}",
        "player-icons": {
            "default": "▶",
            "chromium": "▶"
        },
        "paused-icons": {
            "default": "⏸"
        },
        "max-length": 36,
        "on-click": "playerctl play-pause",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous"
    },

    "custom/wallpaper": {
        "format": "🖼",
        "on-click": "~/.config/waybar/wallpaper.sh",
        "tooltip": true,
        "tooltip-format": "Click to change wallpaper"
    },

    "cpu": {
        "format": "CPU {usage}%",
        "interval": 2,
        "on-click": "kitty -e btop --force-utf"
    },

    "memory": {
        "format": "MEM {percentage}%",
        "interval": 2,
        "tooltip-format": "{used:0.1f}G / {total:0.1f}G"
    },

    "temperature": {
        "critical-threshold": 80,
        "format": "{temperatureC}°C"
    },

    "network": {
        "format-wifi": "WIFI {signalStrength}%",
        "format-ethernet": "ETH {ipaddr}",
        "format-disconnected": "OFFLINE",
        "tooltip-format": "{ifname}: {ipaddr}/{cidr}",
        "on-click": "nm-connection-editor"
    },

    "pulseaudio": {
        "format": "VOL {volume}%",
        "format-muted": "MUTE",
        "on-click": "pavucontrol",
        "scroll-step": 5
    },

    "battery": {
        "states": { "warning": 30, "critical": 15 },
        "format": "DC {capacity}%",
        "format-charging": "AC {capacity}%",
        "format-plugged": "AC {capacity}%"
    },

    "group/tray-group": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 250,
            "children-class": "tray-item",
            "transition-left-to-right": false,
            "click-to-reveal": true
        },
        "modules": ["custom/tray-toggle", "tray"]
    },

    "custom/tray-toggle": {
        "format": "▾",
        "tooltip": false
    },

    "tray": {
        "icon-size": 15,
        "spacing": 8
    }
}
